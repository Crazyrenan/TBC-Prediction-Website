---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/LoginForm';
---

<BaseLayout title="Login | PulmoAI">
  <main class="flex min-h-screen items-center justify-center p-4">
    <div class="scroll-reveal w-full max-w-md opacity-0 translate-y-8 transition-all duration-1000 ease-out">
      <div class="mb-8 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-700 shadow-md">
          <span class="text-xl font-bold text-white">PA</span>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Welcome back</h1>
        <p class="mt-2 text-sm text-slate-600">Enter your credentials to access the system</p>
      </div>
      
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <LoginForm client:only="react" />
      </div>

      <p class="mt-6 text-center text-sm text-slate-600">
        Don't have an account? 
        <a href="/register" class="font-semibold text-cyan-700 hover:text-cyan-800 hover:underline">Request access</a>
      </p>
    </div>
  </main>
</BaseLayout>