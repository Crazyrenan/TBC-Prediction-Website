---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PredictionFlow } from '../components/PredictionFlow';
import HistoryDashboard from '../components/HistoryDashboard';
---

<BaseLayout title="PulmoAI | Dashboard">
  <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-cyan-700 shadow-sm">
          <span class="text-white font-bold text-sm">PA</span>
        </div>
        <div>
          <span class="block text-lg font-semibold tracking-tight text-slate-950">PulmoAI</span>
          <span class="hidden text-xs font-medium text-slate-500 sm:block">Internal Hospital System</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" class="rounded-md px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950">
          Back to Home
        </a>
        <button
          id="dashboard-logout"
          type="button"
          class="hidden rounded-md bg-cyan-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cyan-800"
        >
          Logout
        </button>
      </div>
    </div>
  </nav>

  <main class="min-h-screen border-y border-slate-200 bg-slate-50 px-4 py-12">
    <div class="mx-auto max-w-5xl flex flex-col gap-12">
      
      <!-- Section: New Scan -->
      <section>
        <header class="mb-6">
          <h2 class="text-2xl font-bold text-slate-900">New Scan</h2>
          <p class="text-slate-500 mt-1">Upload a new X-ray for immediate AI analysis.</p>
        </header>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
          <PredictionFlow client:only="react" />
        </div>
      </section>

      <!-- Section: Prediction History -->
      <section>
        <header class="mb-6">
          <h2 class="text-2xl font-bold text-slate-900">Prediction History</h2>
          <p class="text-slate-500 mt-1">Review past diagnostic scans and confidence metrics.</p>
        </header>
        
        <HistoryDashboard client:only="react" />
      </section>

    </div>
  </main>

  <script>
    const logoutButton = document.getElementById('dashboard-logout');

    const syncLogoutButton = () => {
      logoutButton?.classList.toggle('hidden', !localStorage.getItem('auth_token'));
    };

    syncLogoutButton();
    window.addEventListener('auth-state-change', syncLogoutButton);

    logoutButton?.addEventListener('click', async () => {
      try {
        // 1. Panggil endpoint logout untuk menghapus cookie di sisi server
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (error) {
        console.error("Gagal logout dari server", error);
      } finally {
        localStorage.removeItem('auth_token');
        window.dispatchEvent(new Event('auth-state-change'));
        window.location.href = '/';
      }
    });
  </script>
</BaseLayout>
