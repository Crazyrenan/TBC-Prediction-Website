---
import BaseLayout from '../layouts/BaseLayout.astro';
import UploadCard from '../components/UploadCard';
---

<BaseLayout title="PulmoAI | Dashboard">
  <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 px-4 py-3 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-cyan-700 shadow-sm">
          <span class="text-white font-bold text-sm">PA</span>
        </div>
        <div>
          <span class="block text-lg font-semibold tracking-tight text-slate-950">PulmoAI</span>
          <span class="hidden text-xs font-medium text-slate-500 sm:block">Internal Hospital System</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" class="rounded-md px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950">
          Back to Home
        </a>
        <button
          id="dashboard-logout"
          type="button"
          class="hidden rounded-md bg-cyan-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cyan-800"
        >
          Logout
        </button>
      </div>
    </div>
  </nav>

  <main class="border-y border-slate-200 bg-slate-100 px-4 py-12">
    <UploadCard client:only="react" />
  </main>

  <script>
    const logoutButton = document.getElementById('dashboard-logout');

    const syncLogoutButton = () => {
      logoutButton?.classList.toggle('hidden', !localStorage.getItem('auth_token'));
    };

    syncLogoutButton();
    window.addEventListener('auth-state-change', syncLogoutButton);

    logoutButton?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('dashboard-logout'));
    });
  </script>
</BaseLayout>
